# ---- Server ----
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://api.mediinfo.in          # public https URL of this server
JWT_SECRET=                                 # REQUIRED. 64+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DB_FILE=/data/mediinfo.db                   # put on a persistent volume and back it up daily
TRUST_PROXY=1                               # set when behind a load balancer / Render / Fly / Nginx
ADMIN_PHONES=9XXXXXXXXX                     # founder phone(s) that get super-admin on login
CORS_ORIGINS=                               # extra allowed origins, comma separated

# ---- Cashfree (dashboard.cashfree.com → Developers → API Keys) ----
CASHFREE_ENV=SANDBOX                        # change to PRODUCTION only after KYC approval + live keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Set the webhook URL in the Cashfree dashboard to:  <PUBLIC_URL>/api/payments/webhook

# ---- SMS OTP (any DLT-registered provider that accepts a JSON POST, e.g. via a small relay) ----
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
